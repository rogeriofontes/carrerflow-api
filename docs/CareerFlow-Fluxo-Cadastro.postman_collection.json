            }
          ]
        },
        {
          "name": "06 — Empresa Cria um Desafio",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{companyToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Desenvolver API REST com Spring Boot\",\n  \"description\": \"Crie uma API REST completa com autenticação JWT, CRUD e documentação Swagger.\",\n  \"difficulty\": \"MEDIUM\",\n  \"skills\": [\"Java\", \"Spring Boot\", \"REST\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challenges",
              "host": ["{{baseUrl}}"],
              "path": ["challenges"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('challengeId', jsonData.id);",
                  "    pm.test('Desafio criado', function() {",
                  "        pm.expect(jsonData.id).to.not.be.empty;",
                  "        pm.expect(jsonData.title).to.include('API REST');",
                  "    });",
                  "    console.log('✓ Challenge ID salvo: ' + jsonData.id);",
                  "} else {",
                  "    pm.test('Criar desafio falhou — status ' + pm.response.code, function() {",
                  "        pm.expect.fail(pm.response.text());",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 — Listar Desafios (público)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/challenges?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["challenges"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Desafios listados com sucesso', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an('array');",
                  "    pm.expect(jsonData.content.length).to.be.greaterThan(0);",
                  "});",
                  "console.log('✓ ' + pm.response.json().totalElements + ' desafios encontrados');"
                ]
              }
            }
          ]
        },
        {
          "name": "08 — Estudante Submete Resposta STAR",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challengeId\": \"{{challengeId}}\",\n  \"situation\": \"Na empresa onde eu estagiava, o sistema legado causava lentidão e erros frequentes no atendimento ao cliente.\",\n  \"task\": \"Fui designado para redesenhar a API principal, migrando de um monolito para uma arquitetura moderna.\",\n  \"action\": \"Implementei a nova API usando Spring Boot 3 com Clean Architecture, autenticação JWT, testes automatizados e documentação Swagger. Fiz deploy com Docker.\",\n  \"result\": \"O tempo de resposta caiu 60%, os erros reduziram 90% e a equipe ganhou autonomia com a documentação automática.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["submissions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('submissionId', jsonData.id);",
                  "    pm.test('Submissão STAR enviada', function() {",
                  "        pm.expect(jsonData.id).to.not.be.empty;",
                  "        pm.expect(jsonData.situation).to.not.be.empty;",
                  "    });",
                  "    console.log('✓ Submission ID salvo: ' + jsonData.id);",
                  "} else {",
                  "    pm.test('Submissão falhou — status ' + pm.response.code, function() {",
                  "        pm.expect.fail(pm.response.text());",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "09 — Ver Avaliação STAR",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/evaluations/submission/{{submissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["evaluations", "submission", "{{submissionId}}"]
            },
            "description": "A avaliação é criada automaticamente via evento assíncrono após a submissão. Aguarde ~2 segundos após o passo 08."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test('Avaliação STAR recebida', function() {",
                  "        pm.expect(jsonData.finalScore).to.be.a('number');",
                  "        pm.expect(jsonData.finalScore).to.be.greaterThan(0);",
                  "    });",
                  "    console.log('✓ Score final: ' + jsonData.finalScore);",
                  "} else {",
                  "    pm.test('Avaliação ainda não processada — tente novamente em alguns segundos', function() {",
                  "        console.log('⏳ Avaliação assíncrona em andamento...');",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Aguarda 2 segundos para a avaliação assíncrona processar",
                  "setTimeout(function() {}, 2000);"
                ]
              }
            }
          ]
        },
