{
  "info": {
    "name": "CareerFlow — Fluxo Completo de Cadastro",
    "description": "Fluxo completo de cadastro e uso da API CareerFlow.\n\nExecute as requests na ordem (1 a 12) para testar o ciclo inteiro:\nRegister → Profile → Challenge → Submission STAR → Avaliação → Matching → Dashboard\n\nTokens e IDs são salvos automaticamente entre requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "studentToken", "value": "", "type": "string" },
    { "key": "companyToken", "value": "", "type": "string" },
    { "key": "studentUserId", "value": "", "type": "string" },
    { "key": "companyUserId", "value": "", "type": "string" },
    { "key": "studentProfileId", "value": "", "type": "string" },
    { "key": "companyId", "value": "", "type": "string" },
    { "key": "challengeId", "value": "", "type": "string" },
    { "key": "submissionId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Fluxo Completo de Cadastro",
      "description": "Execute na ordem: 01 → 12",
      "item": [
        {
          "name": "01 — Registrar Admin",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@exemplo.com\",\n  \"password\": \"senha1234\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('adminToken', jsonData.accessToken);",
                  "    pm.test('Admin registrado com sucesso', function() {",
                  "        pm.expect(jsonData.accessToken).to.not.be.empty;",
                  "    });",
                  "    console.log('✓ Admin Token salvo');",
                  "} else {",
                  "    pm.test('Registro falhou — status ' + pm.response.code, function() {",
                  "        pm.expect.fail(pm.response.text());",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Registrar Estudante",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"João Silva\",\n  \"email\": \"joao@student.com\",\n  \"password\": \"senha1234\",\n  \"role\": \"STUDENT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('studentToken', jsonData.accessToken);",
                  "    if (jsonData.user && jsonData.user.id) {",
                  "        pm.collectionVariables.set('studentUserId', jsonData.user.id);",
                  "    }",
                  "    pm.test('Estudante registrado com sucesso', function() {",
                  "        pm.expect(jsonData.accessToken).to.not.be.empty;",
                  "    });",
                  "    console.log('✓ Student Token salvo');",
                  "} else {",
                  "    pm.test('Registro falhou — status ' + pm.response.code, function() {",
                  "        pm.expect.fail(pm.response.text());",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
