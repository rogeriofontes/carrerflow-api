            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course\": \"Engenharia de Software\",\n  \"institution\": \"Universidade Federal\",\n  \"skills\": [\"Java\", \"Spring Boot\", \"PostgreSQL\", \"Docker\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": ["{{baseUrl}}"],
              "path": ["students"]
