            },
            "url": {
              "raw": "{{baseUrl}}/matching/search?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["matching", "search"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Matching executado com sucesso', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.content).to.be.an('array');",
                  "});",
                  "console.log('✓ ' + pm.response.json().totalElements + ' estudantes encontrados');"
                ]
              }
            }
          ]
        },
        {
          "name": "12 — Dashboard (login Admin seed)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "dashboard"]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Se não tem adminToken do passo 01, faz login com o admin seed",
                  "var adminToken = pm.collectionVariables.get('adminToken');",
                  "if (!adminToken || adminToken === '') {",
                  "    var baseUrl = pm.collectionVariables.get('baseUrl');",
                  "    pm.sendRequest({",
                  "        url: baseUrl + '/auth/login',",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({ email: 'admin@careerflow.com', password: 'admin123!' })",
                  "        }",
                  "    }, function(err, res) {",
                  "        if (!err && res.code === 200) {",
                  "            var json = res.json();",
                  "            pm.collectionVariables.set('adminToken', json.accessToken);",
                  "            console.log('✓ Admin login automático — Token salvo');",
                  "        }",
                  "    });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard carregado', function() {",
                  "    pm.response.to.have.status(200);",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.totalStudents).to.be.a('number');",
                  "    pm.expect(jsonData.totalCompanies).to.be.a('number');",
                  "    pm.expect(jsonData.totalChallenges).to.be.a('number');",
                  "});",
                  "var d = pm.response.json();",
                  "console.log('✓ Dashboard: ' + d.totalStudents + ' estudantes, ' + d.totalCompanies + ' empresas, ' + d.totalChallenges + ' desafios, score médio: ' + d.averageScore);"
                ]
              }
            }
          ]
        }
      ]
    },
