### ===========================
### AUTH MODULE
### ===========================

### -------------------------------------------------------
### 1. Registrar novo Estudante
### -------------------------------------------------------
POST {{base_url}}/auth/register
Content-Type: application/json

{
  "name": "João Silva",
  "email": "joao@student.com",
  "password": "senha1234",
  "role": "STUDENT"
}

> {%
    client.global.set("student_token", response.body.accessToken);
    client.global.set("student_user_id", response.body.user.id);
    client.log("Student Token salvo!");
%}

### -------------------------------------------------------
### 2. Registrar nova Empresa
### -------------------------------------------------------
POST {{base_url}}/auth/register
Content-Type: application/json

{
  "name": "Tech Corp RH",
  "email": "rh@novaempresa.com",
  "password": "senha1234",
  "role": "COMPANY"
}

> {%
    client.global.set("company_token", response.body.accessToken);
    client.global.set("company_user_id", response.body.user.id);
    client.log("Company Token salvo!");
%}

