### -------------------------------------------------------
### 5. Login como Admin (usuário seed)
### -------------------------------------------------------
POST {{base_url}}/auth/login
Content-Type: application/json

{
  "email": "{{admin_email}}",
  "password": "{{admin_password}}"
}

> {%
    client.global.set("admin_token", response.body.accessToken);
    client.log("Admin Token salvo!");
%}

### -------------------------------------------------------
### 6. Login como Estudante (usuário seed)
### -------------------------------------------------------
POST {{base_url}}/auth/login
Content-Type: application/json

{
  "email": "{{student_email}}",
  "password": "{{student_password}}"
}

> {%
    client.global.set("student_token", response.body.accessToken);
    client.global.set("student_user_id", response.body.user.id);
    client.log("Student Token salvo!");
%}

